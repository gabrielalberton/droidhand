# DroidHand relay/adapter configuration. Copy to .env (gitignored) or set in the systemd unit.
# The token itself is NOT stored here — point to a 0600 file outside git.

DROIDHAND_TOKEN_FILE=/home/youruser/.config/droidhand/token

# Phone-facing relay (expose over Tailscale with: tailscale serve --tcp=8787 tcp://127.0.0.1:8787)
DROIDHAND_RELAY_HOST=127.0.0.1
DROIDHAND_RELAY_PORT=8787

# Loopback control channel the per-session MCP adapters connect to.
DROIDHAND_CONTROL_HOST=127.0.0.1
DROIDHAND_CONTROL_PORT=8788

# Optional
# DROIDHAND_CMD_TIMEOUT_MS=15000
# DROIDHAND_AUDIT_DIR=/home/youruser/.local/state/droidhand/audit
# DROIDHAND_SUGGESTIONS_DIR=/home/youruser/.local/state/droidhand/suggestions
# DROIDHAND_ADB=adb
# DROIDHAND_ADB_SERIAL=
