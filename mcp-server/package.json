{
  "name": "droidhand-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DroidHand MCP server + relay — exposes a personal Android phone to AI agents over MCP.",
  "license": "Apache-2.0",
  "bin": {
    "droidhand-mcp": "dist/index.js",
    "droidhand-relay": "dist/daemon.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "relay": "node dist/daemon.js",
    "mcp": "node dist/index.js",
    "mock-phone": "node --import tsx src/mock-phone-cli.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
